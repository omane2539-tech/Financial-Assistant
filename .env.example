# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Optional Anthropic Claude API Key for AI Financial Tips
# If provided, Claude is used for financial guidance. If omitted, FinSmart AI
# seamlessly utilizes Gemini or intelligent rule-based financial advice.
ANTHROPIC_API_KEY=""

# GOOGLE_SHEETS_ID: Google Spreadsheet ID for storing financial records
GOOGLE_SHEETS_ID=""

# GOOGLE_SERVICE_ACCOUNT: Service account JSON string or credentials for Google Sheets API access
GOOGLE_SERVICE_ACCOUNT=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

